# ==========================================
# Lumina Minimal Tasklist - Environment Variables
# ==========================================

# Port for backend server (defaults to 5000 locally, Render provides this automatically)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# e.g. mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/minimal_tasklist?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/minimal_tasklist?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate any secure random string)
JWT_SECRET=lumina_watercolor_secret_key_2026_xyz

# Frontend API URL (Used by Vercel frontend to point to Render backend)
# In production on Vercel, set this to your Render backend URL:
# e.g. https://to-do-list-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
